# Local environments
.conda/
.venv/
venv/
env/

# Python caches and test artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx

# Large or generated research artifacts
data/**
!data/**/
!data/**/README.md
!data/**/*.md
predictions/
reproduction/idp_edl/outputs/
reproduction/idp_edl/artifacts/
results/**
!results/**/
!results/**/README.md
!results/**/*.md
# Curated, prediction-only IDP-EDL reproduction release. These files omit
# amino-acid sequences and reference labels.
!results/reproduction/idp_edl/*.tsv.gz
!results/reproduction/idp_edl/*.json
!results/reproduction/idp_edl/summary.tsv
!results/reproduction/idp_edl/paper_comparison.tsv
models/**/*.pt
models/**/*.pth
models/**/*.pkl
models/**/*.ckpt
models/**/*.safetensors
references/
*.npy
*.npz
*.h5
*.hdf5

